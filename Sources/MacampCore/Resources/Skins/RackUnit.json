{
  "format": 1,
  "name": "Rack Unit",
  "author": "macamp",
  "window": {
    "size": [380, 300],
    "cornerRadius": 4,
    "background": { "gradient": ["#43474d", "#2a2c30"], "angle": 90 },
    "border": { "color": "#0b0b0c", "width": 1 },
    "titleBar": "none",
    "resize": "vertical",
    "minHeight": 204
  },
  "palette": {
    "amber": "#ffb000",
    "amberDim": "#ffb000b3",
    "amberText": "#c98a00",
    "hot": "#fff2c2",
    "lcd": "#0d0a04",
    "edge": "#0b0b0c",
    "ridge": "#5a5f66",
    "cap": "#e6e8eb",
    "label": "#aeb3ba"
  },
  "elements": [
    { "type": "rect", "frame": [1, 1, 378, 1], "fill": "#6b7078" },
    { "type": "text", "frame": [9, 3, 60, 14], "text": "MACAMP",
      "font": { "family": "systemMono", "size": 9, "weight": "medium" }, "color": "$label" },
    { "type": "rect", "frame": [60, 7, 280, 1], "fill": "#73787f" },
    { "type": "rect", "frame": [60, 8, 280, 1], "fill": "#1b1c1e" },
    { "type": "rect", "frame": [60, 10, 280, 1], "fill": "#73787f" },
    { "type": "rect", "frame": [60, 11, 280, 1], "fill": "#1b1c1e" },
    { "type": "button", "frame": [346, 4, 11, 11], "action": "minimize", "iconSize": 7,
      "style": { "fill": { "gradient": ["#5d6269", "#33363a"] }, "border": { "color": "$edge", "width": 1 },
                 "bevel": { "light": "#858a91", "dark": "#26282b" }, "color": "#d0d3d8" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#4a4e54"] } } },
    { "type": "button", "frame": [361, 4, 11, 11], "action": "close", "iconSize": 7,
      "style": { "fill": { "gradient": ["#5d6269", "#33363a"] }, "border": { "color": "$edge", "width": 1 },
                 "bevel": { "light": "#858a91", "dark": "#26282b" }, "color": "#d0d3d8" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#4a4e54"] } } },

    { "type": "rect", "frame": [8, 85, 364, 1], "fill": "$ridge" },
    { "type": "rect", "frame": [8, 20, 364, 65], "fill": "$lcd",
      "border": { "color": "#000000", "width": 1 }, "cornerRadius": 2 },
    { "type": "text", "frame": [13, 26, 116, 53], "text": "{time:pad}", "action": "toggleTime",
      "font": { "family": "systemMono", "size": 30 },
      "color": "$amber", "glow": { "radius": 6, "color": "#ffb0008c" } },
    { "type": "text", "frame": [136, 24, 228, 19], "text": "{index}. {display} ({duration})", "overflow": "scroll",
      "font": { "family": "systemMono", "size": 11 },
      "color": "$amber", "glow": { "radius": 5, "color": "#ffb0008c" } },
    { "type": "text", "frame": [136, 41, 228, 13], "text": "{codec} · {sampleRate} · {bitrate} · {channels}",
      "font": { "family": "systemMono", "size": 9 }, "color": "$amberDim" },
    { "type": "visualizer", "frame": [136, 56, 228, 24], "bars": 19, "gap": 2, "segment": 2,
      "colors": ["$amber", "$amber", "$amber", "#ff5a1f"],
      "peaks": true, "peakColor": "$hot", "scopeColor": "$amber", "scopeWidth": 1.5 },

    { "type": "rect", "frame": [8, 103, 364, 1], "fill": "$ridge" },
    { "type": "slider", "frame": [8, 91, 364, 14], "binds": "seek",
      "track": { "fill": "#17181a", "border": { "color": "#000000", "width": 1 }, "thickness": 9 },
      "progress": {},
      "thumb": { "size": [24, 13], "fill": { "gradient": ["#8a8f96", "#4a4e54"] },
                 "border": { "color": "#000000", "width": 1 }, "bevel": { "light": "#c1c5ca", "dark": "#33363a" } } },

    { "type": "button", "frame": [8, 112, 30, 24], "action": "previous",
      "style": { "fill": { "gradient": ["#6a6f76", "#3a3d42"] }, "border": { "color": "$edge", "width": 1 },
                 "cornerRadius": 2, "bevel": { "light": "#979ca3", "dark": "#26282b" }, "color": "$cap" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#53575d"] }, "bevel": { "light": "#26282b", "dark": "#6a6f76" } } },
    { "type": "button", "frame": [41, 112, 30, 24], "action": "play",
      "style": { "fill": { "gradient": ["#6a6f76", "#3a3d42"] }, "border": { "color": "$edge", "width": 1 },
                 "cornerRadius": 2, "bevel": { "light": "#979ca3", "dark": "#26282b" }, "color": "$cap" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#53575d"] }, "bevel": { "light": "#26282b", "dark": "#6a6f76" } },
      "on": { "color": "$amber", "glow": 4 } },
    { "type": "button", "frame": [74, 112, 30, 24], "action": "pause",
      "style": { "fill": { "gradient": ["#6a6f76", "#3a3d42"] }, "border": { "color": "$edge", "width": 1 },
                 "cornerRadius": 2, "bevel": { "light": "#979ca3", "dark": "#26282b" }, "color": "$cap" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#53575d"] }, "bevel": { "light": "#26282b", "dark": "#6a6f76" } },
      "on": { "color": "$amber", "glow": 4 } },
    { "type": "button", "frame": [107, 112, 30, 24], "action": "stop",
      "style": { "fill": { "gradient": ["#6a6f76", "#3a3d42"] }, "border": { "color": "$edge", "width": 1 },
                 "cornerRadius": 2, "bevel": { "light": "#979ca3", "dark": "#26282b" }, "color": "$cap" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#53575d"] }, "bevel": { "light": "#26282b", "dark": "#6a6f76" } } },
    { "type": "button", "frame": [140, 112, 30, 24], "action": "next",
      "style": { "fill": { "gradient": ["#6a6f76", "#3a3d42"] }, "border": { "color": "$edge", "width": 1 },
                 "cornerRadius": 2, "bevel": { "light": "#979ca3", "dark": "#26282b" }, "color": "$cap" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#53575d"] }, "bevel": { "light": "#26282b", "dark": "#6a6f76" } } },
    { "type": "button", "frame": [173, 112, 30, 24], "action": "open",
      "style": { "fill": { "gradient": ["#6a6f76", "#3a3d42"] }, "border": { "color": "$edge", "width": 1 },
                 "cornerRadius": 2, "bevel": { "light": "#979ca3", "dark": "#26282b" }, "color": "$cap" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#53575d"] }, "bevel": { "light": "#26282b", "dark": "#6a6f76" } } },
    { "type": "button", "frame": [214, 112, 30, 24], "action": "shuffle", "iconSize": 12,
      "style": { "fill": { "gradient": ["#6a6f76", "#3a3d42"] }, "border": { "color": "$edge", "width": 1 },
                 "cornerRadius": 2, "bevel": { "light": "#979ca3", "dark": "#26282b" }, "color": "$cap" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#53575d"] }, "bevel": { "light": "#26282b", "dark": "#6a6f76" } },
      "on": { "color": "$amber", "glow": 4 } },
    { "type": "button", "frame": [247, 112, 30, 24], "action": "repeat", "iconSize": 12,
      "style": { "fill": { "gradient": ["#6a6f76", "#3a3d42"] }, "border": { "color": "$edge", "width": 1 },
                 "cornerRadius": 2, "bevel": { "light": "#979ca3", "dark": "#26282b" }, "color": "$cap" },
      "hover": { "color": "#ffffff" },
      "pressed": { "fill": { "gradient": ["#33363a", "#53575d"] }, "bevel": { "light": "#26282b", "dark": "#6a6f76" } },
      "on": { "color": "$amber", "glow": 4 } },

    { "type": "slider", "frame": [289, 117, 83, 14], "binds": "volume",
      "track": { "fill": { "gradient": ["#2c6b1f", "#c9a400", "#b23a1a"], "angle": 0 },
                 "border": { "color": "#000000", "width": 1 }, "thickness": 7 },
      "progress": {},
      "thumb": { "size": [10, 14], "fill": { "gradient": ["#8a8f96", "#4a4e54"] },
                 "border": { "color": "#000000", "width": 1 }, "bevel": { "light": "#c1c5ca", "dark": "#33363a" } } },

    { "type": "rect", "frame": [8, 292, 364, 1], "anchor": "bottom", "fill": "$ridge" },
    { "type": "rect", "frame": [8, 144, 364, 148], "anchor": "stretch", "fill": "$lcd",
      "border": { "color": "#000000", "width": 1 } },
    { "type": "playlist", "frame": [9, 147, 362, 142], "anchor": "stretch", "rowHeight": 15,
      "font": { "family": "systemMono", "size": 10.5 },
      "text": "{index}. {display}", "detail": "{duration}",
      "color": "$amberText", "currentColor": "$hot", "currentBackground": "#3a2a00",
      "selectedColor": "$amber", "selectedBackground": "#ffb00026", "padding": 8 }
  ]
}
