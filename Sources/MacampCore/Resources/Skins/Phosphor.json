{
  "format": 1,
  "name": "Phosphor",
  "author": "macamp",
  "window": {
    "size": [380, 316],
    "background": "#101214",
    "titleBar": "system",
    "resize": "vertical",
    "minHeight": 222
  },
  "palette": {
    "glow": "#7dff6e",
    "glowDim": "#7dff6e99",
    "ink": "#c9d2cc",
    "text": "#aab2ad",
    "dim": "#59635d",
    "line": "#2c322f",
    "groove": "#232825",
    "well": "#060807",
    "wellEdge": "#1c211e"
  },
  "elements": [
    { "type": "text", "frame": [74, 7, 120, 14], "text": "MACAMP",
      "font": { "family": "systemMono", "size": 10, "weight": "medium" }, "color": "$dim" },

    { "type": "rect", "frame": [9, 28, 362, 76], "fill": "$well",
      "border": { "color": "$wellEdge", "width": 1 }, "cornerRadius": 6 },
    { "type": "text", "frame": [19, 38, 116, 56], "text": "{time:pad}", "action": "toggleTime",
      "font": { "family": "systemMono", "size": 30, "weight": "light" },
      "color": "$glow", "glow": { "radius": 8, "color": "#7dff6e73" } },
    { "type": "text", "frame": [140, 33, 222, 20], "text": "{index}. {display}", "overflow": "scroll",
      "font": { "family": "systemMono", "size": 11.5 },
      "color": "$glow", "glow": { "radius": 6, "color": "#7dff6e73" } },
    { "type": "text", "frame": [140, 51, 222, 14], "text": "{codec} · {sampleRate} · {bitrate} · {channels}",
      "font": { "family": "systemMono", "size": 9.5 }, "color": "$glowDim" },
    { "type": "visualizer", "frame": [140, 68, 222, 30], "bars": 19, "gap": 2, "segment": 2,
      "colors": ["#58e04a", "#58e04a", "#58e04a", "#f4d03f", "#ff4d3d"],
      "peaks": true, "peakColor": "#d9ffd4", "scopeColor": "$glow", "scopeWidth": 1.5 },

    { "type": "slider", "frame": [9, 110, 362, 11], "binds": "seek",
      "track": { "fill": "$groove", "cornerRadius": 1.5, "thickness": 3 },
      "progress": { "fill": "$glow", "cornerRadius": 1.5 },
      "thumb": { "fill": "#d9ffd4", "size": [3, 11] } },

    { "type": "button", "frame": [9, 127, 30, 24], "action": "previous",
      "style": { "border": { "color": "$line", "width": 1 }, "cornerRadius": 5, "color": "$ink" },
      "hover": { "border": { "color": "$dim", "width": 1 }, "color": "#ffffff" },
      "pressed": { "fill": "$wellEdge", "color": "#ffffff" } },
    { "type": "button", "frame": [43, 127, 30, 24], "action": "play",
      "style": { "border": { "color": "$line", "width": 1 }, "cornerRadius": 5, "color": "$ink" },
      "hover": { "border": { "color": "$dim", "width": 1 }, "color": "#ffffff" },
      "pressed": { "fill": "$wellEdge", "color": "#ffffff" },
      "on": { "border": { "color": "$glow", "width": 1 }, "color": "$glow" } },
    { "type": "button", "frame": [77, 127, 30, 24], "action": "pause",
      "style": { "border": { "color": "$line", "width": 1 }, "cornerRadius": 5, "color": "$ink" },
      "hover": { "border": { "color": "$dim", "width": 1 }, "color": "#ffffff" },
      "pressed": { "fill": "$wellEdge", "color": "#ffffff" },
      "on": { "border": { "color": "$glow", "width": 1 }, "color": "$glow" } },
    { "type": "button", "frame": [111, 127, 30, 24], "action": "stop",
      "style": { "border": { "color": "$line", "width": 1 }, "cornerRadius": 5, "color": "$ink" },
      "hover": { "border": { "color": "$dim", "width": 1 }, "color": "#ffffff" },
      "pressed": { "fill": "$wellEdge", "color": "#ffffff" } },
    { "type": "button", "frame": [145, 127, 30, 24], "action": "next",
      "style": { "border": { "color": "$line", "width": 1 }, "cornerRadius": 5, "color": "$ink" },
      "hover": { "border": { "color": "$dim", "width": 1 }, "color": "#ffffff" },
      "pressed": { "fill": "$wellEdge", "color": "#ffffff" } },
    { "type": "button", "frame": [179, 127, 30, 24], "action": "open",
      "style": { "border": { "color": "$line", "width": 1 }, "cornerRadius": 5, "color": "$ink" },
      "hover": { "border": { "color": "$dim", "width": 1 }, "color": "#ffffff" },
      "pressed": { "fill": "$wellEdge", "color": "#ffffff" } },
    { "type": "button", "frame": [221, 127, 30, 24], "action": "shuffle", "iconSize": 12,
      "style": { "border": { "color": "$line", "width": 1 }, "cornerRadius": 5, "color": "$dim" },
      "hover": { "border": { "color": "$dim", "width": 1 }, "color": "$ink" },
      "pressed": { "fill": "$wellEdge", "color": "#ffffff" },
      "on": { "border": { "color": "$glow", "width": 1 }, "color": "$glow" } },
    { "type": "button", "frame": [255, 127, 30, 24], "action": "repeat", "iconSize": 12,
      "style": { "border": { "color": "$line", "width": 1 }, "cornerRadius": 5, "color": "$dim" },
      "hover": { "border": { "color": "$dim", "width": 1 }, "color": "$ink" },
      "pressed": { "fill": "$wellEdge", "color": "#ffffff" },
      "on": { "border": { "color": "$glow", "width": 1 }, "color": "$glow" } },

    { "type": "slider", "frame": [297, 133, 74, 12], "binds": "volume",
      "track": { "fill": "$groove", "cornerRadius": 1.5, "thickness": 3 },
      "progress": { "fill": "#8b958f", "cornerRadius": 1.5 },
      "thumb": { "fill": "$ink", "size": [3, 11] } },

    { "type": "rect", "frame": [0, 160, 380, 1], "fill": "$wellEdge" },
    { "type": "playlist", "frame": [0, 165, 380, 147], "anchor": "stretch", "rowHeight": 17,
      "font": { "family": "systemMono", "size": 10.5 },
      "text": "{index}. {display}", "detail": "{duration}",
      "color": "$text", "currentColor": "$glow", "currentBackground": "#0d1a0c",
      "selectedColor": "#ffffff", "selectedBackground": "#ffffff14", "padding": 12 }
  ]
}
